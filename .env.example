# Local development only. Copy to .env (gitignored).
# Server-side secret: read by the Vite dev middleware and Cloudflare Pages Functions.
# It has no VITE_ prefix on purpose, so it is never bundled into browser code.
ANTHROPIC_API_KEY=

# Optional
# AI_ENABLED=false            # kill switch: the app runs in offline-sample mode
# RATE_LIMIT_PER_IP=20        # AI calls per 10 minutes per client IP (per server instance)
# RATE_LIMIT_GLOBAL=300       # AI calls per 10 minutes per server instance
# ALLOWED_ORIGINS=            # comma-separated extra origins allowed to call /api/claude
